<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>KiotViet_Label_Printer_Pro_V2</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AcceptNPOIOSMFLicense>true</AcceptNPOIOSMFLicense>

    <!-- Phiên bản hiển thị trong app + ghi log lúc khởi động, để xác nhận
         máy nào đang chạy đúng build nào (xem services/AppInfo.cs). Tăng số
         này mỗi lần phát hành bản mới. -->
    <Version>2.2.1</Version>
    <AssemblyVersion>2.2.1.0</AssemblyVersion>
    <FileVersion>2.2.1.0</FileVersion>
    <InformationalVersion>2.2.1</InformationalVersion>
  </PropertyGroup>

  <!-- Nhúng thời điểm build vào assembly metadata (đọc qua AppInfo). MSBuild
       property function chạy lại mỗi lần build nên luôn là giờ build thật. -->
  <Target Name="StampBuildTimestamp" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildTimestampUtc</_Parameter1>
        <_Parameter2>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss"))</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!-- Test bố cục màn hình Phiếu xuất kho nạp file không qua hộp thoại (WarehouseExportView.LoadFilesAsync). -->
  <ItemGroup>
    <InternalsVisibleTo Include="KiotVietLabelPrinter.Tests" />
  </ItemGroup>

  <!-- Project test nằm trong thư mục con: không biên dịch code test vào app. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- PDFium (Apache-2.0): dựng ảnh từng trang PDF cho Xem trước bản in phiếu xuất kho. -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="152.0.7961" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NPOI" Version="2.8.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.20.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup>
  <None Update="Config\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>

  <None Update="Data\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>

  <None Update="Templates\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>

  <None Update="Assets\**\*">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
  </None>
</ItemGroup>

</Project>